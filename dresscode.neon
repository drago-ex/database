use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
	-
		# tests an entity whose properties are named as the columns
		paths: [tests/TestEntitySnake.php]
		naming: {property: keep}
