{
	"name": "drago-ex/database",
	"description": "Connecting to database for Nette Framework",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"dibi/dibi": "^5.0.2",
		"drago-ex/utils": "^2.1"
	},
	"require-dev": {
		"nette/bootstrap": "^3.2",
		"nette/tester": "^2.5",
		"tracy/tracy": "^2.10",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C"
	}
}
